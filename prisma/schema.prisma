generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContactSubmission {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  email         String
  phone         String   @default("")
  institution   String
  message       String
  hubspotLink   String   @default("")
  createdAt     DateTime @default(now())
}
